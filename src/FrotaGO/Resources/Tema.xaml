<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores -->
    <SolidColorBrush x:Key="CorFundo" Color="#0B0C10"/>
    <SolidColorBrush x:Key="CorCampo" Color="#1B1C21"/>
    <SolidColorBrush x:Key="CorCard" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="CorTexto" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#A3A3A8"/>
    <SolidColorBrush x:Key="CorTextoCard" Color="#121212"/>
    <SolidColorBrush x:Key="CorBorda" Color="#3A3B40"/>
    <SolidColorBrush x:Key="CorErro" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="CorSucesso" Color="#7CF08A"/>
    <SolidColorBrush x:Key="CorTextoCardSecundario" Color="#4A4B50"/>
    <SolidColorBrush x:Key="CorSeloAtivaFundo" Color="#C9F5CF"/>
    <SolidColorBrush x:Key="CorSeloAtivaTexto" Color="#145A1E"/>
    <SolidColorBrush x:Key="CorSeloAgendadaFundo" Color="#FFE7B3"/>
    <SolidColorBrush x:Key="CorSeloAgendadaTexto" Color="#6B4A00"/>
    <SolidColorBrush x:Key="CorSeloNeutroFundo" Color="#E1E1E4"/>
    <SolidColorBrush x:Key="CorSeloNeutroTexto" Color="#3A3B40"/>
    <SolidColorBrush x:Key="CorSeloCanceladaFundo" Color="#F8D4D4"/>
    <SolidColorBrush x:Key="CorSeloCanceladaTexto" Color="#7A1F1F"/>

    <!-- Fonte -->
    <FontFamily x:Key="FontePadrao">pack://application:,,,/Resources/Fonts/#Urbanist</FontFamily>

    <!-- Textos -->
    <Style x:Key="TextoTitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="TextoSubtitulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
    </Style>
    <Style x:Key="TextoRotulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="TextoMensagem" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource CorErro}"/>
    </Style>

    <!-- Botão principal (branco) -->
    <Style x:Key="BotaoPrincipal" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CorTexto}"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoCard}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" CornerRadius="24"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão secundário (contorno) -->
    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoPrincipal}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Botão circular (avatar e sair) -->
    <Style x:Key="BotaoCircular" TargetType="Button" BasedOn="{StaticResource BotaoSecundario}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Link -->
    <Style x:Key="BotaoLink" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campos de texto e senha (aplicados automaticamente) -->
    <Style TargetType="TextBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Background" Value="{StaticResource CorCampo}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CorTexto}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Borda" CornerRadius="24"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource CorTextoSecundario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="Background" Value="{StaticResource CorCampo}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CorTexto}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Borda" CornerRadius="24"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource CorTextoSecundario}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opção do seletor Pessoa física / Pessoa jurídica -->
    <Style x:Key="OpcaoSegmentada" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fundo" CornerRadius="20" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{StaticResource CorTexto}"/>
                            <Setter Property="Foreground" Value="{StaticResource CorTextoCard}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card claro (usado nas próximas telas) -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorCard}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <!-- Textos das homes -->
    <Style x:Key="TextoSaudacao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="TextoSecao" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Margin" Value="0,32,0,16"/>
    </Style>
    <Style x:Key="TextoCardDetalhe" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoCardSecundario}"/>
    </Style>
    <Style x:Key="TextoCabecalhoTabela" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
    </Style>
    <Style x:Key="TextoTabela" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Selo de status: a cor muda conforme a propriedade Status do item exibido -->
    <Style x:Key="SeloFundo" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource CorSeloNeutroFundo}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Ativa">
                <Setter Property="Background" Value="{StaticResource CorSeloAtivaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Agendada">
                <Setter Property="Background" Value="{StaticResource CorSeloAgendadaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelada">
                <Setter Property="Background" Value="{StaticResource CorSeloCanceladaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Expirada">
                <Setter Property="Background" Value="{StaticResource CorSeloCanceladaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em dia">
                <Setter Property="Background" Value="{StaticResource CorSeloAtivaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Atrasada">
                <Setter Property="Background" Value="{StaticResource CorSeloCanceladaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Disponível">
                <Setter Property="Background" Value="{StaticResource CorSeloAtivaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Ativo">
                <Setter Property="Background" Value="{StaticResource CorSeloAtivaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Alugado">
                <Setter Property="Background" Value="{StaticResource CorSeloAgendadaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em andamento">
                <Setter Property="Background" Value="{StaticResource CorSeloAgendadaFundo}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em manutenção">
                <Setter Property="Background" Value="{StaticResource CorSeloCanceladaFundo}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SeloTexto" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource CorSeloNeutroTexto}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Ativa">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAtivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Agendada">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAgendadaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Cancelada">
                <Setter Property="Foreground" Value="{StaticResource CorSeloCanceladaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Expirada">
                <Setter Property="Foreground" Value="{StaticResource CorSeloCanceladaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em dia">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAtivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Atrasada">
                <Setter Property="Foreground" Value="{StaticResource CorSeloCanceladaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Disponível">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAtivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Ativo">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAtivaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Alugado">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAgendadaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em andamento">
                <Setter Property="Foreground" Value="{StaticResource CorSeloAgendadaTexto}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Em manutenção">
                <Setter Property="Foreground" Value="{StaticResource CorSeloCanceladaTexto}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Card de atalho: Content = título, Tag = descrição -->
    <Style x:Key="CardAtalho" TargetType="Button">
        <Setter Property="Height" Value="120"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="{StaticResource CorCard}" CornerRadius="24" Padding="20">
                        <Grid>
                            <Border Width="32" Height="32" CornerRadius="16" BorderThickness="1"
                                BorderBrush="{StaticResource CorTextoCardSecundario}"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="↗" FontSize="14" Foreground="{StaticResource CorTextoCard}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock FontSize="20" Foreground="{StaticResource CorTextoCard}"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <TextBlock FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CorTextoCardSecundario}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixas de seleção: sem isso, o texto fica preto no fundo escuro -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Listas suspensas: mantêm o visual do Windows, com o tamanho dos outros campos -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Opção de pagamento em formato de card -->
    <Style x:Key="OpcaoPagamento" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fundo" Background="{StaticResource CorCampo}" CornerRadius="16"
                        BorderBrush="{StaticResource CorBorda}" BorderThickness="1" Padding="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Marcador" Width="16" Height="16" Margin="0,0,12,0"
                                 Stroke="{StaticResource CorTextoSecundario}" StrokeThickness="2"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource CorTexto}"/>
                            <Setter TargetName="Marcador" Property="Stroke" Value="{StaticResource CorTexto}"/>
                            <Setter TargetName="Marcador" Property="Fill" Value="{StaticResource CorTexto}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Converte true/false em visível/oculto -->
    <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>

    <!-- Tabelas -->
    <Style x:Key="Tabela" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CorBorda}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="RowHeight" Value="52"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" Padding="0,0,8,10">
                        <ContentPresenter VerticalAlignment="Bottom"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="0,0,8,0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>