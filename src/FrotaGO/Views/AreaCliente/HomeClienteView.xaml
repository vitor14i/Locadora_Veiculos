<UserControl x:Class="FrotaGO.Views.AreaCliente.HomeClienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:componentes="clr-namespace:FrotaGO.Views.Componentes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1140" Margin="70,48,70,32">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TextoSaudacao" Style="{StaticResource TextoSaudacao}"/>
                    <TextBlock x:Name="TextoResumo" Style="{StaticResource TextoSubtitulo}" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Content="Minhas reservas" Style="{StaticResource BotaoSecundario}" Margin="0,0,12,0"/>
                    <Button Content="Reservar veículo" Style="{StaticResource BotaoPrincipal}"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="ListaCards" Margin="-8,32,-8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <componentes:CardReservaView Margin="8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TextoVazio" Text="Você não tem reservas no momento."
                       Style="{StaticResource TextoSubtitulo}" Margin="0,32,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>