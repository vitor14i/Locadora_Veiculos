<UserControl x:Class="FrotaGO.Views.Gestao.ManutencoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="1140" Margin="70,48,70,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Manutenções" Style="{StaticResource TextoSaudacao}"/>
                <TextBlock Text="Registre e acompanhe os serviços da frota."
                           Style="{StaticResource TextoSubtitulo}" Margin="0,8,0,0"/>
            </StackPanel>
            <Button Content="Nova manutenção" Style="{StaticResource BotaoPrincipal}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="NovaManutencao_Click"/>
        </Grid>

        <TextBlock x:Name="TextoMensagem" Grid.Row="1" FontSize="14" Foreground="{StaticResource CorSucesso}"
                   Margin="0,16,0,0" Visibility="Collapsed"/>

        <DataGrid x:Name="TabelaManutencoes" Grid.Row="2" Style="{StaticResource Tabela}" Margin="0,24,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Veículo" Binding="{Binding Veiculo}" Width="1.6*"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*"/>
                <DataGridTextColumn Header="Início" Binding="{Binding Inicio}" Width="1.2*"/>
                <DataGridTextColumn Header="Fim" Binding="{Binding Fim}" Width="1.2*"/>
                <DataGridTemplateColumn Header="Situação" Width="1.3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SeloFundo}">
                                <TextBlock Text="{Binding Status}" Style="{StaticResource SeloTexto}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Ação" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Finalizar →" FontSize="15" Style="{StaticResource BotaoLink}"
                                    Visibility="{Binding EmAndamento, Converter={StaticResource BoolParaVisibilidade}}"
                                    Click="Finalizar_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>