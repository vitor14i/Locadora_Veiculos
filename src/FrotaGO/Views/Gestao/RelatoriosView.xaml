<UserControl x:Class="FrotaGO.Views.Gestao.RelatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="1140" Margin="70,48,70,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Relatórios" Style="{StaticResource TextoSaudacao}"/>
            <TextBlock Text="Acompanhe o faturamento e os veículos mais locados."
                       Style="{StaticResource TextoSubtitulo}" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Período -->
        <Grid Grid.Row="1" Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Início (dd/mm/aaaa)" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoInicio"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Fim (dd/mm/aaaa)" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoFim"/>
            </StackPanel>
            <Button Grid.Column="4" Content="Atualizar" Style="{StaticResource BotaoPrincipal}"
                    VerticalAlignment="Bottom" IsDefault="True" Click="Atualizar_Click"/>
        </Grid>

        <TextBlock x:Name="TextoMensagem" Grid.Row="2" Style="{StaticResource TextoMensagem}"
                   Margin="0,12,0,0" Visibility="Collapsed"/>

        <!-- Resumo -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="-8,24,-8,0">
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Faturamento" FontSize="14" Foreground="{StaticResource CorTextoCardSecundario}"/>
                    <TextBlock x:Name="TextoFaturamento" FontSize="28" Margin="0,8,0,0"
                               Foreground="{StaticResource CorTextoCard}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Locações" FontSize="14" Foreground="{StaticResource CorTextoCardSecundario}"/>
                    <TextBlock x:Name="TextoLocacoes" FontSize="28" Margin="0,8,0,0"
                               Foreground="{StaticResource CorTextoCard}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <StackPanel>
                    <TextBlock Text="Valor médio por locação" FontSize="14"
                               Foreground="{StaticResource CorTextoCardSecundario}"/>
                    <TextBlock x:Name="TextoValorMedio" FontSize="28" Margin="0,8,0,0"
                               Foreground="{StaticResource CorTextoCard}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="4" Text="Veículos mais locados" Style="{StaticResource TextoSecao}"/>

        <DataGrid x:Name="TabelaRanking" Grid.Row="5" Style="{StaticResource Tabela}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Posição" Binding="{Binding Posicao}" Width="*"/>
                <DataGridTextColumn Header="Veículo" Binding="{Binding Veiculo}" Width="3*"/>
                <DataGridTextColumn Header="Locações" Binding="{Binding Locacoes}" Width="*"/>
                <DataGridTextColumn Header="Faturamento" Binding="{Binding Faturamento}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="TextoVazio" Grid.Row="5" Text="Nenhuma locação nesse período."
                   Style="{StaticResource TextoSubtitulo}" Margin="0,56,0,0" Visibility="Collapsed"/>
    </Grid>
</UserControl>