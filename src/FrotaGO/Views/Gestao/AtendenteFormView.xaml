<UserControl x:Class="FrotaGO.Views.Gestao.AtendenteFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="720" HorizontalAlignment="Center" Margin="0,48,0,32">
        <TextBlock Text="Novo atendente" Style="{StaticResource TextoTitulo}" HorizontalAlignment="Center"/>
        <TextBlock Text="Informe uma senha temporária. O atendente pode trocá-la depois pelo perfil."
                   Style="{StaticResource TextoSubtitulo}" HorizontalAlignment="Center" Margin="0,8,0,24"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                <TextBlock Text="Nome completo" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoNome"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16">
                <TextBlock Text="E-mail" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoEmail"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16">
                <TextBlock Text="Matrícula" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoMatricula"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Senha temporária" Style="{StaticResource TextoRotulo}"/>
                <PasswordBox x:Name="CampoSenha"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Confirmar senha" Style="{StaticResource TextoRotulo}"/>
                <PasswordBox x:Name="CampoConfirmarSenha"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="TextoMensagem" Style="{StaticResource TextoMensagem}"
                   Margin="0,16,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,24,0,0">
            <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                    HorizontalAlignment="Left" Click="Cancelar_Click"/>
            <Button Content="Cadastrar atendente" Style="{StaticResource BotaoPrincipal}"
                    HorizontalAlignment="Right" Click="Cadastrar_Click"/>
        </Grid>
    </StackPanel>
</UserControl>