<UserControl x:Class="FrotaGO.Views.Componentes.PagamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <UniformGrid Columns="2" Margin="-8,0">
            <RadioButton x:Name="OpcaoCartao" Content="Cartão" GroupName="FormaPagamento" IsChecked="True"
                         Style="{StaticResource OpcaoPagamento}" Margin="8,0" Checked="Forma_Checked"/>
            <RadioButton x:Name="OpcaoPix" Content="Pix" GroupName="FormaPagamento"
                         Style="{StaticResource OpcaoPagamento}" Margin="8,0" Checked="Forma_Checked"/>
        </UniformGrid>

        <!-- Cartão -->
        <Grid x:Name="PainelCartao" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Bandeira" Style="{StaticResource TextoRotulo}"/>
                <ComboBox x:Name="CampoBandeira"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Últimos 4 dígitos" Style="{StaticResource TextoRotulo}"/>
                <TextBox x:Name="CampoDigitos" MaxLength="4"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Parcelas" Style="{StaticResource TextoRotulo}"/>
                <ComboBox x:Name="CampoParcelas"/>
            </StackPanel>
        </Grid>

        <!-- Pix -->
        <StackPanel x:Name="PainelPix" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Código da transação" Style="{StaticResource TextoRotulo}"/>
            <TextBox x:Name="CampoCodigoPix"/>
        </StackPanel>
    </StackPanel>
</UserControl>